---
import { ArrowLeft, ArrowUpRight, Check, Github, Server, Workflow } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro'; import { projects } from '../../data/projects'; import '../../styles/global.css';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={`${project.name} — Aaron Hernandez`}><main class={`case-study ${project.accent}`} transition:name={`project-${project.slug}`}><nav class="case-nav wrap"><a href="/#work" class="back"><ArrowLeft size={17}/> VOLVER A PROYECTOS</a><a class="brand" href="/">AHC<span>_</span></a></nav><header class="case-hero wrap"><p class="label">[ {project.number} — CASE STUDY ]</p><p class="case-type">{project.type}</p><h1>{project.name}</h1><p class="case-summary">{project.summary}</p><div class="case-actions"><a class="button" href={project.github} target="_blank" rel="noreferrer"><Github size={17}/> VER GITHUB <ArrowUpRight size={17}/></a></div></header><section class="case-section wrap"><p class="label">[ ROL ]</p><h2>{project.role}</h2></section><section class="case-section wrap"><p class="label">[ TECNOLOGÍAS ]</p><div class="tech-wall">{project.stack.map((item) => <span>{item}</span>)}</div></section><section class="case-section wrap"><p class="label">[ ARQUITECTURA ]</p><div class="architecture"><div class="arch-mark"><Workflow size={35}/></div><div>{project.architecture.map((item,index) => <div class="arch-item"><span>0{index+1}</span><p>{item}</p></div>)}</div></div></section><section class="case-section wrap"><p class="label">[ QUÉ HACE ]</p><div class="capabilities">{project.capabilities.map((item) => <p><Check size={18}/>{item}</p>)}</div></section><section class="case-section wrap"><p class="label">[ DESPLIEGUE ]</p><div class="deployment"><Server size={32}/><div>{project.deployment.map((item) => <p>{item}</p>)}</div></div></section><footer class="case-footer wrap"><a href="/#work" class="back"><ArrowLeft size={17}/> TODOS LOS PROYECTOS</a><a href={project.github} target="_blank" rel="noreferrer">GITHUB <ArrowUpRight size={17}/></a></footer></main></BaseLayout>
