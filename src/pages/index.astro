---
import { ArrowDownRight, ArrowUpRight, AtSign, BriefcaseBusiness, Code2, Github, Phone, Terminal, Zap } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
const projects = [
  { number:'01', name:'Academy', type:'SaaS EDUCATION PLATFORM', description:'Plataforma de educación online diseñada y desarrollada end-to-end: cursos, usuarios, inscripciones, pagos y video protegido.', stack:['Django REST','Next.js','PostgreSQL','Redis','Celery','Stripe','R2'], url:'https://github.com/hecabre/Academy', accent:'lime' },
  { number:'02', name:'WhatsApp AI Platform', type:'MULTI-TENANT / RAG / WORKFLOWS', description:'Plataforma conversacional multi-tenant con aislamiento por cliente, RAG, automatizaciones e integraciones para WhatsApp.', stack:['TypeScript','Node.js','n8n','pgvector','Redis','Docker'], url:'https://github.com/hecabre/chat', accent:'olive' },
  { number:'03', name:'E-commerce API', type:'PAYMENTS / REST API', description:'Backend de comercio electrónico con productos, carrito, órdenes, validación y pagos mediante Stripe.', stack:['Node.js','Express','Zod','MySQL','Stripe'], url:'https://github.com/hecabre', accent:'sand' },
];
---
<BaseLayout>
  <main id="top">
    <section class="hero wrap"><nav><a class="brand" href="#top">AHC<span>_</span></a><div><a href="#work">PROYECTOS</a><a href="#contact">CONTACTO</a></div></nav>
      <div class="hero-grid"><p class="eyebrow reveal"><Terminal size={15}/> AVAILABLE FOR WORK / 2026</p><h1 class="reveal">AARON<br/><em>HERNÁNDEZ</em><br/>CABRERA<span>.</span></h1><div class="hero-copy reveal"><b>FULL STACK DEVELOPER</b><p>Construyo productos SaaS completos: de la arquitectura y los datos hasta la interfaz, infraestructura y despliegue.</p><a class="button" href="#work">VER PROYECTOS <ArrowDownRight size={18}/></a></div></div>
      <div class="ticker">TYPESCRIPT <b>✳</b> PYTHON <b>✳</b> DJANGO <b>✳</b> NODE.JS <b>✳</b> POSTGRESQL <b>✳</b> DOCKER <b>✳</b></div></section>
    <section class="statement wrap reveal"><p class="label">[ 01 — PERFIL ]</p><div><h2>NO SOLO ESCRIBO ENDPOINTS.<br/><span>CONSTRUYO EL SISTEMA ENTERO.</span></h2><p>Un año de experiencia profesional desarrollando aplicaciones web y productos SaaS. TypeScript, Python, Django REST Framework, React, Next.js, PostgreSQL, Redis y Docker.</p></div></section>
    <section class="projects" id="work"><div class="wrap heading reveal"><p class="label">[ 02 — PROYECTOS ]</p><h2>SELECCIÓN<br/>DE TRABAJO</h2></div>{projects.map((project) => <article class={`project ${project.accent} reveal`}><div class="wrap project-grid"><p class="number">{project.number}</p><div><p class="label">{project.type}</p><h3>{project.name}</h3></div><div class="detail"><p>{project.description}</p><ul>{project.stack.map((item) => <li>{item}</li>)}</ul></div><a class="round" href={project.url} target="_blank" rel="noreferrer" aria-label={`Abrir ${project.name} en GitHub`}><ArrowUpRight /></a></div></article>)}</section>
    <section class="experience wrap reveal"><p class="label">[ 03 — EXPERIENCIA ]</p><div class="experience-card"><div class="icon"><BriefcaseBusiness size={27}/></div><div><p class="label">2025 — ACTUALIDAD</p><h2>DENTARIOS</h2></div><p>Full Stack Developer. Desarrollo de APIs, interfaces, bases de datos, autenticación, webhooks, tareas asíncronas y servicios Dockerizados.</p></div></section>
    <section class="about wrap reveal"><p class="label">[ 04 — DATOS ]</p><div class="facts"><div><Code2/><strong>1 AÑO</strong><span>EXPERIENCIA PROFESIONAL</span></div><div><Zap/><strong>B1</strong><span>INGLÉS</span></div><div><AtSign/><strong>UPIICSA</strong><span>ING. INFORMÁTICA / EN CURSO</span></div></div></section>
    <section class="contact" id="contact"><div class="wrap contact-inner reveal"><p class="label">[ 05 — CONTACTO ]</p><h2>¿CONSTRUIMOS<br/><em>ALGO ÚTIL?</em></h2><a class="email" href="mailto:aaroncabrera046@gmail.com">aaroncabrera046@gmail.com <ArrowUpRight/></a><div class="meta"><a href="tel:+525536095119"><Phone size={15}/> +52 55 3609 5119</a><a href="https://github.com/hecabre" target="_blank" rel="noreferrer"><Github size={16}/> github.com/hecabre</a></div></div></section>
  </main>
  <script>
    import { gsap } from 'gsap'; import { ScrollTrigger } from 'gsap/ScrollTrigger'; gsap.registerPlugin(ScrollTrigger);
    gsap.from('.hero .reveal', { y:48, opacity:0, duration:.8, stagger:.12, ease:'power3.out' });
    gsap.utils.toArray('.reveal').slice(3).forEach((element) => gsap.from(element, { y:44, opacity:0, duration:.7, ease:'power3.out', scrollTrigger:{trigger:element, start:'top 85%', once:true} }));
  </script>
</BaseLayout>
