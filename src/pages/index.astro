<section class="projects" id="work"><div class="wrap heading reveal"><p class="label">[ 02 — PROYECTOS ]</p><h2>SELECCIÓN<br/>DE TRABAJO</h2></div>{projects.map((project) => <article class={`project ${project.accent} reveal`} transition:name={`project-${project.slug}`}><div class="wrap project-grid"><p class="number">{project.number}</p><div><p class="label">{project.type}</p><h3>{project.name}</h3></div><div class="detail"><p>{project.summary}</p><ul>{project.stack.map((item) => <li>{item}</li>)}</ul></div><a class="round" href={`/projects/${project.slug}`} aria-label={`Ver caso de estudio de ${project.name}`}><ArrowUpRight /></a></div></article>)}</section>
<section class="experience wrap reveal"><p class="label">[ 03 — EXPERIENCIA ]</p><div class="experience-card"><div class="icon"><BriefcaseBusiness size={27}/></div><div><p class="label">2025 — ACTUALIDAD</p><h2>DENTARIOS</h2></div><p>Full Stack Developer. APIs, interfaces, bases de datos, autenticación, webhooks, tareas asíncronas y servicios Dockerizados.</p></div></section>
<section class="about wrap reveal"><p class="label">[ 04 — DATOS ]</p><div class="facts fact-grid"><div><Code2/><strong>1 AÑO</strong><span>EXPERIENCIA PROFESIONAL</span></div><div><Zap/><strong>B1</strong><span>INGLÉS</span></div><div><AtSign/><strong>LINUX</strong><span>DOCKER · TRAEFIK · DOKPLOY</span></div><div><AtSign/><strong>UPIICSA</strong><span>ING. INFORMÁTICA / EN CURSO</span></div></div></section>
