</main><script>import { gsap } from 'gsap'; import { ScrollTrigger } from 'gsap/ScrollTrigger'; gsap.registerPlugin(ScrollTrigger); gsap.from('.hero .reveal',{y:48,opacity:0,duration:.8,stagger:.12,ease:'power3.out'}); gsap.utils.toArray('.reveal').slice(3).forEach((element)=>gsap.from(element,{y:44,opacity:0,duration:.7,ease:'power3.out',scrollTrigger:{trigger:element,start:'top 85%',once:true}}));</script></BaseLayout>
